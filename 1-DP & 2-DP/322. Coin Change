class Solution {
public:
    int solve(int amount, vector<int>& coins, vector<int>& dp) {
        if (amount == 0)
            return 0;
        if (amount < 0)
            return INT_MAX;
        if (dp[amount] != -1)
            return dp[amount];
        int ans = INT_MAX;
        for (auto c : coins) {
            int res = solve(amount - c, coins, dp);
            if (res != INT_MAX) {
                ans = min(res + 1, ans);
            }
        }
        return dp[amount] = ans;
    }
    int coinChange(vector<int>& coins, int amount) {
        int n = coins.size();
        vector<int> dp(amount + 1, -1);
        int ans = solve(amount, coins, dp);
        return (ans == INT_MAX) ? -1 : ans;
    }
};

