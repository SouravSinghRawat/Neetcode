class Solution {
public:
    int longestConsecutive(vector<int>& nums) {
        int n=nums.size();
        unordered_map<int,int>mp;
        for(auto it:nums){
            mp[it]=1;
        }
        int ans=0;
        for(auto it:mp){
            int cnt=0;
            if(mp.find(it.first - 1)==mp.end()){
                int temp=it.first;
                cnt++;
                while(mp.find(temp+1)!=mp.end()){
                    cnt++;
                    temp=temp+1;
                }
            }
            ans=max(cnt,ans);
        }
        return ans;
    }
};

//We just had to find, whether the certain element is the starting of the chain or not, which we can find out, by, checking whether the element-1 is present or not.
