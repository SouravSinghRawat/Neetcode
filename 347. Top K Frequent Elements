class Solution {
public:
    vector<int> topKFrequent(vector<int>& nums, int k) {
        unordered_map<int,int>mp;
        for(auto it:nums){
            mp[it]++;
        }
        priority_queue<pair<int,int>>pq;
        for(auto it:mp){
            pq.push({it.second,it.first});
        }
        vector<int>ans;
        while(!pq.empty()&&k>0){
            auto ele=pq.top();
            ans.push_back(ele.second);
            k--;
            pq.pop();
        }

        return ans;

    }
};

