class Solution {
public:
    bool isPalin(int i, int j, string s) {
        while (i <= j) {
            if (s[i++] != s[j--])
                return false;
        }
        return true;
    }
    void solve(int ind, int n, string s, vector<string>& temp,
               vector<vector<string>>& ans) {
        if (ind >= n) {
            ans.push_back(temp);
            return;
        }
        for (int i = ind; i < n; i++) {
            if (isPalin(ind, i, s)) {
                temp.push_back(s.substr(ind, i - ind + 1));
                solve(i + 1, n, s, temp, ans);
                temp.pop_back();
            }
        }
    }
    vector<vector<string>> partition(string s) {
        vector<vector<string>> ans;
        vector<string> temp;
        int n = s.length();
        solve(0, n, s, temp, ans);
        return ans;
    }
};
