class Solution {
public:
    void solve(int i, int n, unordered_map<char, string>& mp, string& temp,
               vector<string>& ans, string& digits) {

        if (i == n) {
            ans.push_back(temp);
            return;
        }

        string str = mp[digits[i]];

        for (auto ch : str) {
            temp.push_back(ch);
            solve(i + 1, n, mp, temp, ans, digits);
            temp.pop_back();
        }
    }
    vector<string> letterCombinations(string digits) {
        int n = digits.length();
        unordered_map<char, string> keypad = {
            {'1', ""},     {'2', "abc"}, {'3', "def"},
            {'4', "ghi"},  {'5', "jkl"}, {'6', "mno"},
            {'7', "pqrs"}, {'8', "tuv"}, {'9', "wxyz"}};

        vector<string> ans;
        string temp = "";
        solve(0, n, keypad, temp, ans, digits);
        return ans;
    }
};

