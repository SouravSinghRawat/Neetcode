class Solution {
public:
    void solve(int i, int n, int target, vector<int>& candidates,
               vector<int>& temp, vector<vector<int>>& ans) {
        if (target == 0) {
            ans.push_back(temp);
            return;
        }
        if (i >= n)
            return;

        if (candidates[i] <= target) {
            temp.push_back(candidates[i]);
            solve(i, n, target - candidates[i], candidates, temp, ans);
            temp.pop_back();
        }

        solve(i + 1, n, target, candidates, temp, ans);
    }
    vector<vector<int>> combinationSum(vector<int>& candidates, int target) {
        int n = candidates.size();
        vector<vector<int>> ans;
        vector<int> temp;
        solve(0, n, target, candidates, temp, ans);
        return ans;
    }

//Take, Not Take, but with little condition,
};
