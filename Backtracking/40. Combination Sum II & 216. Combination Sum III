class Solution {
public:
    void solve(int target, int i, int n, vector<int>& temp,
               vector<int>& candidates, vector<vector<int>>& ans) {
        if (target == 0) {
            ans.push_back(temp);
            return;
        }
        if (i >= n)
            return;
        if (candidates[i] <= target) {
            temp.push_back(candidates[i]);
            solve(target - candidates[i], i + 1, n, temp, candidates, ans);
            temp.pop_back();
        }
        int j = i + 1;
        while (j<n && j>0 && candidates[j] == candidates[j - 1])
            j++;

        solve(target, j, n, temp, candidates, ans);
    }
    vector<vector<int>> combinationSum2(vector<int>& candidates, int target) {
        sort(candidates.begin(), candidates.end());
        vector<vector<int>> ans;
        vector<int> temp;
        solve(target, 0, candidates.size(), temp, candidates, ans);

        return ans;
    }
};



//Below is the Combination sum III, just one more constraint, and that is the size of container.

class Solution {
public:
    void solve(int target, int i, int n, int size, vector<int>& temp,
               vector<vector<int>>& ans) {
        if (size == 0) {
            if (target == 0) {
                ans.push_back(temp);
                return;
            }
        }
        if (i > n)
            return;
        if (i <= target) {
            temp.push_back(i);
            solve(target - i, i + 1, n, size - 1, temp, ans);
            temp.pop_back();
        }

        solve(target, i + 1, n, size, temp, ans);
    }

    vector<vector<int>> combinationSum3(int k, int n) {
        vector<vector<int>> ans;
        vector<int> temp;
        solve(n, 1, 9, k, temp, ans);
        return ans;
    }
};
