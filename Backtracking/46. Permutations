class Solution {
public:
    void solve(int n, vector<int>& vis, vector<int>& nums, vector<int>& temp,
               vector<vector<int>>& ans) {
        if (temp.size() == n) {
            ans.push_back(temp);
            return;
        }
        for (int i = 0; i < n; i++) {
            if (vis[i] == -1) {
                temp.push_back(nums[i]);
                vis[i] = 1;
                solve(n, vis, nums, temp, ans);
                temp.pop_back();
                vis[i] = -1;
            }
        }
    }
    vector<vector<int>> permute(vector<int>& nums) {
        int n = nums.size();
        vector<int> vis(n, -1);
        vector<vector<int>> ans;
        vector<int> temp;
        solve(n, vis, nums, temp, ans);
        return ans;
    }
};



/Permutations II. Remove duplicates, by skipping the duplicate elemtents to be passed in the recursion.

class Solution {
public:
    void solve(int n, vector<int>& vis, vector<int>& nums, vector<int>& temp,
               vector<vector<int>>& ans) {
        if (temp.size() == n) {
            ans.push_back(temp);
            return;
        }
        for (int i = 0; i < n; i++) {
            if (i > 0 && nums[i] == nums[i - 1] && vis[i - 1] == -1)
                continue;
            if (vis[i] == -1) {
                temp.push_back(nums[i]);
                vis[i] = 1;
                solve(n, vis, nums, temp, ans);
                temp.pop_back();
                vis[i] = -1;
            }
        }
    }
    vector<vector<int>> permuteUnique(vector<int>& nums) {
        sort(nums.begin(), nums.end());
        int n = nums.size();
        vector<int> vis(n, -1);
        vector<vector<int>> ans;
        vector<int> temp;
        solve(n, vis, nums, temp, ans);
        return ans;
    }
};
