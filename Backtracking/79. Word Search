class Solution {
public:
    int dx[4] = {1, -1, 0, 0};
    int dy[4] = {0, 0, 1, -1};
    bool solve(int ind, int i, int j, int m, int n, vector<vector<int>>& vis,
               string word, vector<vector<char>>& board) {

        if (ind == word.length() - 1 && word[ind] == board[i][j])
            return true;

        for (int d = 0; d < 4; d++) {
            int x = i + dx[d];
            int y = j + dy[d];
            if (x >= 0 && x < m && y >= 0 && y < n && vis[x][y] == -1 &&
                word[ind + 1] == board[x][y]) {
                vis[x][y] = 1;
                if (solve(ind + 1, x, y, m, n, vis, word, board))
                    return true;
                vis[x][y] = -1;
            }
        }

        return false;
    }
    bool exist(vector<vector<char>>& board, string word) {
        int m = board.size();
        int n = board[0].size();
        vector<vector<int>> vis(m, vector<int>(n, -1));
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (word[0] == board[i][j]) {
                    vis[i][j] = 1;
                    if (solve(0, i, j, m, n, vis, word, board))
                        return true;
                    vis[i][j] = -1;
                }
            }
        }
        return false;
    }
};

