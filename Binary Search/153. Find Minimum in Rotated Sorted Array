class Solution {
public:
    int findMin(vector<int>& nums) {
        int n = nums.size();
        int i = 0, j = n - 1;

        while (i < j) {
            int mid = i + (j - i) / 2;
            if (mid + 1 < n && nums[mid + 1] < nums[mid])
                return nums[mid + 1];

            if (mid - 1 > -1 && nums[mid] < nums[mid - 1])
                return nums[mid];

            if (nums[mid] > nums[j]) {
                i = mid + 1;
            } else if (nums[mid] < nums[j]) {
                j = mid;
            }
        }
        return nums[0];
    }
};


//Tip: compare mid with respect to the last element present in the array. if mid is smaller, then we have to go more left, otherwise if mid is greater, then we have to go more right.
