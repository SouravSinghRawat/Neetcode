class Solution {
public:
    double findMedianSortedArrays(vector<int>& nums1, vector<int>& nums2) {
        vector<int>temp;
        for(auto it:nums1) temp.push_back(it);
        for(auto it:nums2) temp.push_back(it);

        sort(temp.begin(),temp.end());

        if(temp.size()%2!=0){
            return (double)temp[temp.size()/2];
        }else{
            return ((double)temp[(temp.size()-1)/2] + (double)temp[((temp.size()-1)/2)+1])/2;
        }
    }
};
//O(n) solution

