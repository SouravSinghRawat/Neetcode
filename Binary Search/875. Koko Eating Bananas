class Solution {
public:
    int minEatingSpeed(vector<int>& piles, int h) {
        int l = 1;
        int r = 0;

        for (int p : piles)
            r = max(r, p);

        while (l <= r) {
            int mid = l + (r - l) / 2;

            long long hrs = 0;
            for (int p : piles) {
                hrs += (p + mid - 1) / mid;
                if (hrs > h)
                    break;
            }

            if (hrs > h)
                l = mid + 1;
            else
                r = mid - 1;
        }

        return l;
    }
};

