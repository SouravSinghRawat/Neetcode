class Solution {
public:
    vector<int> dx = {-1, 0, 1, 0};
    vector<int> dy = {0, -1, 0, 1};

    void dfs(int i, int j, int m, int n, vector<vector<bool>>& vis,
             vector<vector<int>>& grid, int& area) {

        vis[i][j] = true;
        area++; // increment shared counter

        for (int dir = 0; dir < 4; dir++) {
            int x = i + dx[dir];
            int y = j + dy[dir];

            if (x >= 0 && x < n && y >= 0 && y < m && !vis[x][y] &&
                grid[x][y] == 1) {

                dfs(x, y, m, n, vis, grid, area);
            }
        }
    }

    int maxAreaOfIsland(vector<vector<int>>& grid) {
        int n = grid.size();
        int m = grid[0].size();

        vector<vector<bool>> vis(n, vector<bool>(m, false));
        int maxi = 0;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                if (!vis[i][j] && grid[i][j] == 1) {

                    int area = 0; // reset for new island
                    dfs(i, j, m, n, vis, grid, area);

                    maxi = max(maxi, area);
                }
            }
        }

        return maxi;
    }
};
