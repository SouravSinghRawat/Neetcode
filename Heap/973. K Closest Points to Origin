class Solution {
public:
    vector<vector<int>> kClosest(vector<vector<int>>& points, int k) {
        priority_queue<pair<double, vector<int>>> pq;
        for (auto it : points) {
            int x = it[0];
            int y = it[1];
            double dist = sqrt((x * x) + (y * y));
            pq.push({dist, {x, y}});
            if (pq.size() > k)
                pq.pop();
        }
        vector<vector<int>> ans;
        while (!pq.empty()) {
            auto pair = pq.top().second;
            ans.push_back(pair);
            pq.pop();
        }
        return ans;
    }
};
