class Solution {
public:
    ListNode* addTwoNumbers(ListNode* l1, ListNode* l2) {

        int carry = 0;
        ListNode* head = nullptr;
        ListNode* curr1 = l1;
        ListNode* curr2 = l2;
        ListNode* Next = nullptr;

        while (curr1 != nullptr || curr2 != nullptr || carry) {
            int sum = carry;

            if (curr1 != nullptr) {
                sum += curr1->val;
                curr1 = curr1->next;
            }

            if (curr2 != nullptr) {
                sum += curr2->val;
                curr2 = curr2->next;
            }

            carry = sum / 10;
            sum %= 10;

            if (head == nullptr) {
                ListNode* newNode = new ListNode(sum);
                head = newNode;
                Next = head;
            } else {
                ListNode* newNode = new ListNode(sum);
                Next->next = newNode;
                Next = Next->next;
            }
        }

        return head;
    }
};


//Add Two Numbers ||

class Solution {
public:
    ListNode* addTwoNumbers(ListNode* l1, ListNode* l2) {
        stack<int> st1, st2;

        while (l1) {
            st1.push(l1->val);
            l1 = l1->next;
        }

        while (l2) {
            st2.push(l2->val);
            l2 = l2->next;
        }

        int carry = 0;
        ListNode* head = nullptr;

        while (!st1.empty() || !st2.empty() || carry) {
            int sum = carry;

            if (!st1.empty()) {
                sum += st1.top();
                st1.pop();
            }

            if (!st2.empty()) {
                sum += st2.top();
                st2.pop();
            }

            carry = sum / 10;
            sum %= 10;

            ListNode* newNode = new ListNode(sum);
            newNode->next = head;
            head = newNode;
        }

        return head;
    }
};
