class Solution {
public:
    ListNode* reverseList(ListNode* head) {
        ListNode* curr=head;
        ListNode* Next;
        ListNode* dummy=nullptr;
        while(curr!=nullptr){
            Next=curr->next;
            curr->next=dummy;
            dummy=curr;
            curr=Next;
        }
        return dummy;

    }
};

