class Solution {
public:
    ListNode* mergeTwoLists(ListNode* list1, ListNode* list2) {
        if(list1==nullptr) return list2;
        if(list2==nullptr) return list1;
        ListNode* curr;
        ListNode* ans;
        if(list1->val<=list2->val) {
            curr=list1;
            ans=list1;
            list1=list1->next;
        }else{
            curr=list2;
            ans=list2;
            list2=list2->next;
        }

        while(list1!=nullptr && list2!=nullptr){
            if(list1->val<list2->val){
                curr->next=list1;
                list1=list1->next;
            }else{
                curr->next=list2;
                list2=list2->next;
            }
            curr=curr->next;
        }

        curr->next=list1==nullptr?list2:list1;
        return ans;
    }
};

