class Solution {
public:
    ListNode* mergeKLists(vector<ListNode*>& lists) {

        if (lists.size() == 0)
            return nullptr;

        priority_queue<int, vector<int>, greater<int>> pq;

        for (int i = 0; i < lists.size(); i++) {
            ListNode* curr = lists[i];
            while (curr != nullptr) {
                pq.push(curr->val);
                curr = curr->next;
            }
        }

        if (pq.empty())
            return nullptr;

        ListNode* head = new ListNode(pq.top());
        pq.pop();
        ListNode* temp = head;

        while (!pq.empty()) {
            ListNode* Next = new ListNode(pq.top());
            temp->next = Next;
            temp = temp->next;
            pq.pop();
        }

        return head;
    }
};
