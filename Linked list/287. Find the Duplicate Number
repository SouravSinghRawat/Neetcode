class Solution {
public:
    int findDuplicate(vector<int>& nums) {
        int tortoise=0;
        int hare=0;
        while(true){
            tortoise=nums[tortoise];
            hare=nums[nums[hare]];
            if(tortoise==hare) break;
        }

        int tortoise2=0;
        while(true){
            tortoise=nums[tortoise];
            tortoise2=nums[tortoise2];
            if(tortoise==tortoise2) return tortoise;
        }

        return -1;

    }
};
