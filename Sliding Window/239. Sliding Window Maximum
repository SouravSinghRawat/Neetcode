class Solution {
public:
    vector<int> maxSlidingWindow(vector<int>& nums, int k) {
        deque<int> dq;
        int n = nums.size();
        int i = 0;
        vector<int> ans;
        for (int j = 0; j < n; j++) {
            while (!dq.empty() && nums[dq.back()] < nums[j]) {
                dq.pop_back();
            }
            if ((j - i + 1) > k) {
                if (!dq.empty() && dq.front() == i) {
                    dq.pop_front();
                }
                i++;
            }
            dq.push_back(j);

            if ((j - i + 1) == k)
                ans.push_back(nums[dq.front()]);
        }
        return ans;
    }
};

//Tip: whenever max, or min in the sliding window, always use deque.
