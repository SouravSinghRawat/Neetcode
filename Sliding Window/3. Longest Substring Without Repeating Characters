class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        int maxL = 0;
        int n = s.length();
        if (n == 0)
            return 0;
        if (n == 1)
            return 1;

        vector<int> v(256, 0);
        int i = 0, j = 0;
        while (j < n) {

            if (v[s[j]] == 0) {
                v[s[j]]++;
                int l = j - i + 1;
                maxL = max(maxL, l);
                j++;
            } else {
                    v[s[i]]--;
                    i++;
            }
        }
        return maxL;
    }
};
