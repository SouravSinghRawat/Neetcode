class Solution {
public:
    int characterReplacement(string s, int k) {
        vector<int> freq(26, 0);
        int maxFreq = 0;
        int n = s.length();
        int maxL = 0;

        int i = 0, j = 0;
        while (j < n) {

            freq[s[j] - 'A']++;
            maxFreq = max(maxFreq, freq[s[j] - 'A']);

            while ((j - i + 1) - maxFreq > k) {
                freq[s[i] - 'A']--;
                i++;
            }

            maxL = max(maxL, (j - i + 1));
            j++;
        }

        return maxL;
    }
};
