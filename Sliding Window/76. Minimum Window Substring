class Solution {
public:
    string minWindow(string s, string t) {
        int m = s.length();
        int n = t.length();
        if(n > m) return "";
        unordered_map<char,int> mp;
        for(char c : t){
            mp[c]++;
        }
        int required = n;
        int i = 0;
        int minLen = INT_MAX;
        int start = 0;

        for(int j = 0; j < m; j++){
            if(mp[s[j]] > 0){
                required--;
            }
            mp[s[j]]--;
            while(required == 0){
                if(j - i + 1 < minLen){
                    minLen = j - i + 1;
                    start = i;
                }
                mp[s[i]]++;
                if(mp[s[i]] > 0){
                    required++;
                }
                i++;
            }
        }
        return minLen == INT_MAX ? "" : s.substr(start, minLen);
    }
};

//Tip: expand window till required characters are covered and shrink while characters are still covered.
