class Solution {
public:
    int carFleet(int target, vector<int>& position, vector<int>& speed) {
        int n = position.size();
        if (n == 0)
            return 0;
        vector<pair<float, float>> p;
        for (int i = 0; i < n; i++) {
            p.push_back({(float)position[i], (float)speed[i]});
        }
        sort(p.begin(), p.end());

        vector<float> time(n);
        for (int i = n - 1; i >= 0; i--) {
            float t = ((float)target - (float)p[i].first) / (float)p[i].second;
            time[i] = t;
        }
        for (float it : time) {
            cout << it << " ";
        }

        float curr_max = time[n - 1];
        int cnt = 1;
        for (int i = n - 2; i >= 0; i--) {

            if (time[i] > curr_max) {
                cnt++;
                curr_max = time[i];
            }
        }

        return cnt;
    }

//Tip: No need of stack
};
