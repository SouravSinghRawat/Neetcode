//Car Fleet II

class Solution {
public:
    vector<double> getCollisionTimes(vector<vector<int>>& cars) {
        stack<int> st;
        int n = cars.size();
        vector<double> ans(n, -1);

        for (int i = n - 1; i >= 0; i--) {
            double pos = cars[i][0];
            double speed = cars[i][1];
            while (!st.empty()) {
                double speedx = cars[st.top()][1];
                double posx=cars[st.top()][0];
                if (speed <= speedx) {
                    st.pop();
                    continue;
                }
                double t = (double)(posx - pos) / (speed - speedx);
                if (ans[st.top()] != -1 && t > ans[st.top()])
                    st.pop();
                else {
                    ans[i] = t;
                    break;
                }
            }

            st.push(i);
        }

        return ans;
    }
};


