class Solution {
public:
    vector<vector<int>> levelOrder(TreeNode* root) {
        queue<TreeNode*>q;
        vector<vector<int>>ans;
        if(!root) return ans;
        q.push(root);
        while(!q.empty()){
            int s=q.size();
            vector<int>helper;
            for(int i=0;i<s;i++){
                TreeNode* temp=q.front();
                q.pop();
                helper.push_back(temp->val);
                if(temp->left) q.push(temp->left);
                if(temp->right) q.push(temp->right);
            }
            ans.push_back(helper);
        }
        return ans;
    }
};
