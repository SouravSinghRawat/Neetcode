class Solution {
public:
    void solve(TreeNode* root,vector<int>&temp){
        if(root==nullptr) return;
        solve(root->left,temp);
        temp.push_back(root->val);
        solve(root->right,temp);
    }
    int kthSmallest(TreeNode* root, int k) {
    vector<int>temp;
    solve(root,temp);
    return temp[k-1];    
    }
};
