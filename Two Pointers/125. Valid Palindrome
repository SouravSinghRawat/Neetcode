    bool validPalindrome(string s) {
        int n=s.length();
        int i=0;
        int j=n-1;
        while(i<j){
            if(s[i]==s[j]){
                i++;j--;
            }else{
               return remove(s,i+1,j)||remove(s,i,j-1);
            }
        }
        return true;
    }
};
