class Solution {
public:
    vector<vector<int>> threeSum(vector<int>& nums) {
        int n=nums.size();
        vector<vector<int>>ans;
        set<vector<int>>st;
        sort(nums.begin(),nums.end());
        for(int i=0;i<n;i++){
            int j=i+1,k=n-1;
            while(j<k){
                if(nums[j]+nums[k]+nums[i]==0){
                    st.insert({nums[i],nums[j],nums[k]});
                    j++;k--;
                }
                if(nums[j]+nums[k]+nums[i]<0){
                    j++;
                }
                else if(nums[j]+nums[k]+nums[i]>0){
                    k--;
                }
            }
        }
        for(auto it:st){
            ans.push_back(it);
        }
        return ans;
    }
};
