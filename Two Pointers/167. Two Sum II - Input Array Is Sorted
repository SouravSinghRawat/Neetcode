class Solution {
public:
    vector<int> twoSum(vector<int>& s, int target) {
        int n=s.size();
        int i=0;
        int j=n-1;
        while(i<j){
            if((s[i]+s[j])==target){
                return {i+1,j+1};
            }
            if(s[i]+s[j]>target) j--;
            else if(s[i]+s[j]<target) i++;
        }
        return {-1,-1};
    }
};
